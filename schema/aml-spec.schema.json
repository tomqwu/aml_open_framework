{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aml-open-framework.org/schema/aml-spec.schema.json",
  "title": "AML Open Framework Spec",
  "description": "Spec contract for the aml.yaml file. One spec governs data contracts, detection rules, reviewer workflow, and regulator reporting.",
  "type": "object",
  "required": ["version", "program", "data_contracts", "rules", "workflow"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "program": { "$ref": "#/$defs/program" },
    "data_contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/data_contract" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "workflow": { "$ref": "#/$defs/workflow" },
    "reporting": { "$ref": "#/$defs/reporting" },
    "retention_policy": { "$ref": "#/$defs/retention_policy" },
    "metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/metric" }
    },
    "reports": {
      "type": "array",
      "items": { "$ref": "#/$defs/report" }
    },
    "information_sharing": {
      "type": "object",
      "additionalProperties": false,
      "description": "PR-DATA-10: cross-bank / cross-border AML information-sharing declaration (FATF R.18 / Wolfsberg CBDDQ / FinCEN 314(b) / AMLA). Opt-in.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "partners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fi_id"],
            "additionalProperties": false,
            "properties": {
              "fi_id":          { "type": "string", "minLength": 1 },
              "label":          { "type": "string" },
              "jurisdictions":  { "type": "array", "items": { "type": "string" } },
              "typology_scope": { "type": "array", "items": { "type": "string" } },
              "salt_rotation":  { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly"] }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "program": {
      "type": "object",
      "required": ["name", "jurisdiction", "regulator", "owner", "effective_date"],
      "additionalProperties": false,
      "properties": {
        "name":           { "type": "string", "minLength": 1 },
        "jurisdiction":   { "type": "string", "minLength": 2 },
        "regulator":      { "type": "string", "minLength": 2 },
        "owner":          { "type": "string", "minLength": 1 },
        "effective_date": { "type": "string", "format": "date" },
        "ai_audit_log":   { "type": "string", "enum": ["hash_only", "full_text"], "default": "hash_only" },
        "legacy_reference": { "$ref": "#/$defs/legacy_reference" },
        "nfrs":             { "$ref": "#/$defs/nfrs" },
        "sla":              { "$ref": "#/$defs/program_sla" }
      }
    },
    "program_sla": {
      "type": "object",
      "description": "PR-LF1 (#383): Pillar-6 SLA-breach + batch-lateness monitor. Engine evaluates per-run and emits `sla_report.json` in the run dir. All fields optional with defaults; omit the block to disable the monitor.",
      "additionalProperties": false,
      "properties": {
        "alert_disposition_days":     { "type": "integer", "minimum": 0, "default": 30, "description": "Max age (days) before an open alert is considered breached. Counted from `case_opened` ts until a terminal decision (`closed`/`escalated_to_str`)." },
        "batch_cadence_days":         { "type": "integer", "minimum": 0, "default": 1,  "description": "Expected cadence of the data extract in days (e.g. 1 = daily, 7 = weekly)." },
        "batch_lateness_grace_days":  { "type": "integer", "minimum": 0, "default": 1,  "description": "Grace window in days before a late batch is flagged. Lateness fires when `as_of - max(transaction_date) > cadence + grace`." }
      }
    },
    "nfrs": {
      "type": "object",
      "description": "PR-D2 (#375): operational NFR declaration. All fields optional. Engine ignores at runtime; surfaces consume for capacity planning, BCP/DR posture, regulator pack.",
      "additionalProperties": false,
      "properties": {
        "rto_minutes":        { "type": "integer", "exclusiveMinimum": 0, "description": "Recovery Time Objective in minutes (BCP/DR — OSFI E-21, FFIEC)." },
        "rpo_minutes":        { "type": "integer", "minimum": 0, "description": "Recovery Point Objective in minutes. 0 = zero data loss tolerated." },
        "sla_p95_ms":         { "type": "integer", "exclusiveMinimum": 0, "description": "Alert-emission latency target p95 (relevant for streaming/both rules)." },
        "throughput_per_min": { "type": "integer", "exclusiveMinimum": 0, "description": "Transaction-rate ceiling the program is designed for." },
        "retention_days":     { "type": "integer", "exclusiveMinimum": 0, "description": "Alert/case/evidence retention horizon (operator-facing rollup)." },
        "notes":              { "type": "string" }
      }
    },
    "legacy_reference": {
      "type": "object",
      "description": "PR-EQ-1 (TM Gap 1): pointer to a legacy alert export for parallel-run divergence classification. Pure metadata — the engine ignores this field at run time; engine/equivalence.py (PR-EQ-2) consumes it to join legacy↔new alerts and emit LEGACY_EQUIV_CHECK events.",
      "required": ["path", "key_columns"],
      "additionalProperties": false,
      "properties": {
        "path":         { "type": "string", "minLength": 1, "description": "Filesystem path or URI to the legacy alert export (CSV / Parquet / JSONL)." },
        "format":       { "type": "string", "enum": ["csv", "parquet", "jsonl"], "default": "csv" },
        "dataset":      { "type": "string", "description": "Optional logical name for the legacy system (e.g. 'mantas_v2', 'sas_aml_3.1') — surfaced in dashboards + audit events." },
        "key_columns":  {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Columns that identify a legacy alert (e.g. ['alert_id'] or ['rule_id', 'customer_id', 'window_start']) for the join with run_dir/alerts/*.jsonl."
        },
        "rule_map": {
          "type": "object",
          "description": "PR-EQ-2: optional new→legacy rule_id mapping consumed by engine/equivalence.py. Keys are new-framework rule_ids (must exist on this spec); values are the corresponding legacy rule identifiers.",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "data_contract": {
      "type": "object",
      "required": ["id", "source", "columns"],
      "additionalProperties": false,
      "properties": {
        "id":             { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "source":         { "type": "string", "minLength": 1 },
        "freshness_sla":  { "type": "string", "pattern": "^[0-9]+[smhd]$" },
        "allow_empty":    { "type": "boolean", "default": false },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "quality_checks": {
          "type": "array",
          "items": { "type": "object" }
        },
        "layer": {
          "type": "string",
          "description": "PR-D1: optional medallion-architecture stage hint for this data contract (bronze/silver/gold). Engine ignores at runtime; surfaces consume for medallion-architecture provenance (Data Integration page, regulator pack, NFR dashboard). Additive — defaults to unset.",
          "enum": ["bronze", "silver", "gold"]
        }
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type":        { "type": "string", "enum": ["string", "integer", "decimal", "boolean", "date", "timestamp"] },
        "nullable":    { "type": "boolean", "default": true },
        "pii":         { "type": "boolean", "default": false },
        "enum":        { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "max_staleness_days":       { "type": "integer", "minimum": 1, "description": "Per-attribute freshness pin (DATA-2). Set together with `last_refreshed_at_column`; engine emits a `pkyc_trigger` for rows older than this." },
        "last_refreshed_at_column": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Sibling timestamp/date column used to evaluate `max_staleness_days`." }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "name", "severity", "regulation_refs", "logic", "escalate_to"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name":     { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status":   { "type": "string", "enum": ["active", "experimental", "deprecated"], "default": "active" },
        "evaluation_mode": { "type": "string", "enum": ["batch", "streaming", "both"], "default": "batch" },
        "regulation_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["citation", "description"],
            "additionalProperties": false,
            "properties": {
              "citation":    { "type": "string" },
              "description": { "type": "string" },
              "url":         { "type": "string", "format": "uri" }
            }
          }
        },
        "logic":       { "$ref": "#/$defs/logic" },
        "escalate_to": { "type": "string" },
        "evidence":    { "type": "array", "items": { "type": "string" } },
        "tags":        { "type": "array", "items": { "type": "string" } },
        "tuning_grid": {
          "type": "object",
          "description": "Sweep grid consumed by `aml tune`. Keys are dot-paths into the rule (e.g. `logic.having.count`); values are lists of candidate values.",
          "additionalProperties": { "type": "array", "minItems": 1 }
        },
        "aml_priority": {
          "type": "string",
          "description": "FinCEN AML/CFT priority this rule helps detect. Consumed by `generators/effectiveness.py` for the FinCEN-NPRM Effectiveness Evidence Pack.",
          "enum": [
            "corruption",
            "cybercrime",
            "terrorist_financing",
            "fraud",
            "transnational_criminal_organization",
            "drug_trafficking",
            "human_trafficking",
            "proliferation_financing",
            "other"
          ]
        },
        "model_tier": {
          "type": "string",
          "description": "MRM tier (SR 26-2 / Interagency Statement) used by `generators/mrm.py` to set validation cadence and materiality.",
          "enum": ["high", "medium", "low"]
        },
        "validation_cadence_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "Required validation cadence in months. Defaults by tier (high=12, medium=18, low=24)."
        },
        "business_intent": {
          "type": "string",
          "minLength": 1,
          "description": "PR-A2: free-text rationale for why this rule exists, written for an examiner / 2LoD reviewer (not a regulation citation — those go in regulation_refs). Stored on the loaded spec for downstream surfaces (STR narrative generator, audit pack, MRM dossier) to consume in a follow-up PR. This PR is additive-only and lands the schema/model field."
        },
        "out_of_scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "PR-A2: explicit list of activities/typologies this rule does NOT catch. Stored on the loaded spec for the regulator-pack 'why didn't this fire on case X' answer in a follow-up PR. This PR is additive-only."
        },
        "risk_tier": {
          "type": "string",
          "description": "PR-RISK-1: first-class risk tier for this rule (low/medium/high). Closes the Pillar 5 'risk-based controls' gap on the North-Star Coverage page — today priority is signalled via `severity` and routing via `escalate_to`, neither of which is a risk attribute. Stored on the loaded spec for a follow-up PR to wire into alert-priority + queue routing. This PR is additive-only.",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "logic": {
      "oneOf": [
        { "$ref": "#/$defs/logic_aggregation_window" },
        { "$ref": "#/$defs/logic_list_match" },
        { "$ref": "#/$defs/logic_custom_sql" },
        { "$ref": "#/$defs/logic_python_ref" },
        { "$ref": "#/$defs/logic_network_pattern" }
      ]
    },
    "logic_aggregation_window": {
      "type": "object",
      "required": ["type", "source", "group_by", "window", "having"],
      "additionalProperties": false,
      "properties": {
        "type":     { "const": "aggregation_window" },
        "source":   { "type": "string" },
        "filter":   { "type": "object" },
        "group_by": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "window":   { "type": "string", "pattern": "^[0-9]+[smhd]$" },
        "having":   { "type": "object", "minProperties": 1 }
      }
    },
    "logic_list_match": {
      "type": "object",
      "required": ["type", "source", "field", "list", "match"],
      "additionalProperties": false,
      "properties": {
        "type":      { "const": "list_match" },
        "source":    { "type": "string" },
        "field":     { "type": "string" },
        "list":      { "type": "string" },
        "match":     { "type": "string", "enum": ["exact", "fuzzy"] },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "logic_custom_sql": {
      "type": "object",
      "required": ["type", "sql"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "custom_sql" },
        "sql":  { "type": "string", "minLength": 1 }
      }
    },
    "logic_python_ref": {
      "type": "object",
      "required": ["type", "callable", "model_id", "model_version"],
      "additionalProperties": false,
      "properties": {
        "type":          { "const": "python_ref" },
        "callable":      { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$" },
        "model_id":      { "type": "string" },
        "model_version": { "type": "string" }
      }
    },
    "logic_network_pattern": {
      "type": "object",
      "required": ["type", "having"],
      "additionalProperties": false,
      "properties": {
        "type":     { "const": "network_pattern" },
        "source":   { "type": "string" },
        "pattern":  { "type": "string", "enum": ["component_size", "common_counterparty"] },
        "max_hops": { "type": "integer", "minimum": 1, "maximum": 5 },
        "having":   { "type": "object", "minProperties": 1 }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["queues"],
      "additionalProperties": false,
      "properties": {
        "queues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "sla"],
            "additionalProperties": false,
            "properties": {
              "id":              { "type": "string" },
              "sla":             { "type": "string", "pattern": "^[0-9]+[smhd]$" },
              "next":            { "type": "array", "items": { "type": "string" } },
              "regulator_form":  { "type": "string" }
            }
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["template"],
            "additionalProperties": true,
            "properties": {
              "template":         { "type": "string" },
              "mandatory_fields": { "type": "array", "items": { "type": "string" } },
              "trigger":          { "type": "object" }
            }
          }
        }
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9]+[smhdy]$" }
    },
    "metric": {
      "type": "object",
      "required": ["id", "name", "category", "audience", "formula"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name":     { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["operational", "effectiveness", "risk", "regulatory", "delivery"]
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["svp", "vp", "director", "manager", "pm", "developer", "business", "auditor", "analyst"]
          }
        },
        "owner":    { "type": "string" },
        "unit":     { "type": "string" },
        "formula":  { "$ref": "#/$defs/metric_formula" },
        "target":   { "type": "object" },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "green": { "type": "object" },
            "amber": { "type": "object" },
            "red":   { "type": "object" }
          }
        }
      }
    },
    "metric_formula": {
      "oneOf": [
        { "$ref": "#/$defs/formula_count" },
        { "$ref": "#/$defs/formula_sum" },
        { "$ref": "#/$defs/formula_ratio" },
        { "$ref": "#/$defs/formula_coverage" },
        { "$ref": "#/$defs/formula_sql" }
      ]
    },
    "formula_count": {
      "type": "object",
      "required": ["type", "source"],
      "additionalProperties": false,
      "properties": {
        "type":   { "const": "count" },
        "source": { "type": "string", "enum": ["alerts", "cases", "decisions", "rules", "txn", "customer"] },
        "filter": { "type": "object" },
        "distinct_by": { "type": "string" }
      }
    },
    "formula_sum": {
      "type": "object",
      "required": ["type", "source", "field"],
      "additionalProperties": false,
      "properties": {
        "type":   { "const": "sum" },
        "source": { "type": "string", "enum": ["alerts", "cases", "txn"] },
        "field":  { "type": "string" },
        "filter": { "type": "object" }
      }
    },
    "formula_ratio": {
      "type": "object",
      "required": ["type", "numerator", "denominator"],
      "additionalProperties": false,
      "properties": {
        "type":        { "const": "ratio" },
        "numerator":   { "$ref": "#/$defs/metric_formula" },
        "denominator": { "$ref": "#/$defs/metric_formula" }
      }
    },
    "formula_coverage": {
      "type": "object",
      "required": ["type", "universe", "covered_by"],
      "additionalProperties": false,
      "properties": {
        "type":       { "const": "coverage" },
        "universe":   { "type": "string", "enum": ["typologies", "jurisdictions", "products"] },
        "covered_by": { "type": "string", "enum": ["rule_tags", "regulation_refs"] }
      }
    },
    "formula_sql": {
      "type": "object",
      "required": ["type", "sql"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "sql" },
        "sql":  { "type": "string" }
      }
    },
    "report": {
      "type": "object",
      "required": ["id", "audience", "cadence", "sections"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title":    { "type": "string" },
        "audience": {
          "type": "string",
          "enum": ["svp", "vp", "director", "manager", "pm", "developer", "business", "auditor", "analyst"]
        },
        "cadence":  { "type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "annual", "on_demand"] },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "metrics"],
            "additionalProperties": false,
            "properties": {
              "title":   { "type": "string" },
              "metrics": { "type": "array", "items": { "type": "string" } },
              "commentary": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
